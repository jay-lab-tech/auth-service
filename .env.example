NODE_ENV=development
PORT=3000

# Laragon PostgreSQL. Replace the database name and credentials for your local setup.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/auth_service?schema=public

# Redis will be provided by Docker during local development.
REDIS_URL=redis://127.0.0.1:6379

# Replace both with long, unique random values before running the application.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
