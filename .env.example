NODE_ENV=development
PORT=3000

# Local Laragon PostgreSQL. Add credentials here if your instance requires them.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/auth_service?schema=public

# Redis will be provided by Docker during local development.
REDIS_URL=redis://127.0.0.1:6379

# Replace with a unique random value of at least 32 characters. Sample only; do not use in production.
JWT_ACCESS_SECRET=local-development-only-replace-with-a-unique-48-character-secret
